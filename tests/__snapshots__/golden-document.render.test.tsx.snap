  <span class="hljs-attr">"features"</span><span class="hljs-punctuation">:</span> <span class="hljs-punctuation">[</span><span class="hljs-string">"GFM"</span><span class="hljs-punctuation">,</span> <span class="hljs-string">"KaTeX"</span><span class="hljs-punctuation">,</span> <span class="hljs-string">"Mermaid"</span><span class="hljs-punctuation">]</span>
<span class="hljs-punctuation">}</span>
